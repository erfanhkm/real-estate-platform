/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com https://cdn.jsdelivr.net 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; img-src 'self' data: blob: https://tile.openstreetmap.org; font-src 'self' data:; connect-src 'self' https://advisor-api.erfanbillion.workers.dev https://ai-chat.erfanbillion.workers.dev https://seller-api.erfanbillion.workers.dev https://newsletter-signup.erfanbillion.workers.dev https://advisor-academy.erfanbcrealestate.workers.dev https://formsubmit.co https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; worker-src 'self'; manifest-src 'self'; media-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000

/portal-*
  X-Robots-Tag: noindex, nofollow

/fonts/*
  Cache-Control: public, max-age=2592000

/photos/*
  Cache-Control: public, max-age=2592000

/tours/*
  Cache-Control: public, max-age=604800

/bundle-*
  Cache-Control: public, max-age=2592000
